# Pinned, offline CPU-only renderer. Never link this target into the core or C API.
set(thorvg_root "${CMAKE_CURRENT_SOURCE_DIR}/third_party/thorvg")
set(thorvg_dirs common renderer renderer/cpu_engine loaders/raw loaders/svg loaders/sfnt loaders/png)
set(thorvg_sources)
set(thorvg_includes)
foreach(dir IN LISTS thorvg_dirs)
  file(GLOB sources CONFIGURE_DEPENDS "${thorvg_root}/src/${dir}/*.cpp")
  list(APPEND thorvg_sources ${sources})
  list(APPEND thorvg_includes "${thorvg_root}/src/${dir}")
endforeach()
# The portable rasterizer works on all supported CPUs, without forcing AVX2.
list(FILTER thorvg_sources EXCLUDE REGEX "tvgSwRasterSimd.cpp$")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated/thorvg")
configure_file(cmake/thorvg_config.h.in generated/thorvg/config.h COPYONLY)
add_library(slopfab_thorvg STATIC ${thorvg_sources})
target_include_directories(slopfab_thorvg SYSTEM PUBLIC "${thorvg_root}/inc")
target_include_directories(slopfab_thorvg PRIVATE ${thorvg_includes} "${CMAKE_CURRENT_BINARY_DIR}/generated/thorvg")
target_compile_definitions(slopfab_thorvg PUBLIC TVG_STATIC PRIVATE NOMINMAX _CRT_SECURE_NO_WARNINGS)
if(MSVC)
  target_compile_options(slopfab_thorvg PRIVATE /w /utf-8)
else()
  target_compile_options(slopfab_thorvg PRIVATE -w)
endif()
