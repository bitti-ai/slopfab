file(WRITE "${OUTPUT}" "#include <string>\n#include <stdexcept>\nnamespace slopfab::whisper {\n")
foreach(name multilingual.tiktoken gpt2.tiktoken profiles.json)
  string(MAKE_C_IDENTIFIER "${name}" symbol)
  file(READ "${ROOT}/resources/whisper/${name}" data HEX)
  string(REGEX REPLACE "(..)" "0x\\1," data "${data}")
  file(APPEND "${OUTPUT}" "static const unsigned char ${symbol}[] = {${data}};\n")
endforeach()
file(APPEND "${OUTPUT}" "std::string embedded_asset(const std::string& name) {\n")
foreach(name multilingual.tiktoken gpt2.tiktoken profiles.json)
  string(MAKE_C_IDENTIFIER "${name}" symbol)
  file(APPEND "${OUTPUT}" "if(name==\"${name}\") return std::string(reinterpret_cast<const char*>(${symbol}), sizeof(${symbol}));\n")
endforeach()
file(APPEND "${OUTPUT}" "throw std::invalid_argument(\"unknown Whisper asset\");\n}\n}\n")
