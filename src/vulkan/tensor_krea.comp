#version 450
#extension GL_EXT_shader_16bit_storage : require
// BF16 transformer tensors and FP32 VAE tensors use explicit storage encoding.
// Operation indices match src/krea/vulkan_runtime.h.
layout(local_size_x=256) in;
layout(binding=0,std430) readonly buffer X { uint16_t x[]; };
layout(binding=1,std430) readonly buffer W { uint16_t w[]; };
layout(binding=2,std430) readonly buffer B { uint16_t b[]; };
layout(binding=3,std430) buffer Y { uint16_t y[]; };
layout(push_constant) uniform Params { uint p[16]; };
shared float s[256];
shared float scores[12];
float xf(uint i) { return uintBitsToFloat(uint(x[i])<<16); }
float wf(uint i) { return uintBitsToFloat(uint(w[i])<<16); }
float bf_(uint i) { return uintBitsToFloat(uint(b[i])<<16); }
float x32(uint i) { return uintBitsToFloat(uint(x[2*i])|(uint(x[2*i+1])<<16)); }
float w32(uint i) { return uintBitsToFloat(uint(w[2*i])|(uint(w[2*i+1])<<16)); }
float b32(uint i) { return uintBitsToFloat(uint(b[2*i])|(uint(b[2*i+1])<<16)); }
uint narrow(float v) { uint u=floatBitsToUint(v); return (u+0x7fffu+((u>>16)&1u))>>16; }
float bf(float v) { return uintBitsToFloat(narrow(v)<<16); }
void put(uint i,float v) { y[i]=uint16_t(narrow(v)); }
void put32(uint i,float v) { uint u=floatBitsToUint(v); y[2*i]=uint16_t(u); y[2*i+1]=uint16_t(u>>16); }
// Shared MOSS/Fibo image operations. Indices match moss/vulkan_runtime.h.
shared float squares[256], dq[128], dk[128];
float erf_approx(float a) {
  float z=abs(a),tt=1/(1+.3275911*z);
  float v=1-(((((1.061405429*tt-1.453152027)*tt)+1.421413741)*tt-.284496736)*tt+.254829592)*tt*exp(-z*z);
  return sign(a)*v;
}
void image_operation(uint op,uint g,uint t) {
  uint n=p[1],cols=p[2],i=g*256+t;
  if(op==16 || op==22) {
    if(g>=n)return;
    precise float sum=0,sq=0;
    for(uint c=t;c<cols;c+=256){float a=xf(g*cols+c);sum+=a;sq+=a*a;}
    s[t]=sum;squares[t]=sq;barrier();
    for(uint d=128;d>0;d/=2){if(t<d){s[t]+=s[t+d];squares[t]+=squares[t+d];}barrier();}
    float mean=op==22&&p[5]==0?s[0]/float(cols):0;
    float eps=uintBitsToFloat(op==16?p[4]:p[6]);
    float inv=inversesqrt(max(squares[0]/float(cols)-mean*mean,0)+eps);
    for(uint c=t;c<cols;c+=256){
      float a=(xf(g*cols+c)-mean)*inv;
      if(op==16)a=p[3]!=0?bf(a*(1+wf(c))):bf(bf(a)*wf(c));
      else if(p[3]!=0)a=a*wf(c)+(p[4]!=0?bf_(c):0);
      put(g*cols+c,a);
    }return;
  }
  if(op==21) {
    // One workgroup per value head, preserving the recurrent state in FP32.
    float state[128];for(uint j=0;j<128;++j)state[j]=0;
    uint head=g,kh=head/2;
    for(uint r=0;r<n;++r){
      if(t<128){dq[t]=xf(r*8192+kh*128+t);dk[t]=xf(r*8192+2048+kh*128+t);}
      barrier();s[t]=t<128?dq[t]*dq[t]:0;squares[t]=t<128?dk[t]*dk[t]:0;barrier();
      for(uint d=64;d>0;d/=2){if(t<d){s[t]+=s[t+d];squares[t]+=squares[t+d];}barrier();}
      float qi=inversesqrt(s[0]+1e-6)*.08838834764831845,ki=inversesqrt(squares[0]+1e-6);
      barrier();if(t<128){dq[t]*=qi;dk[t]*=ki;}barrier();
      if(t<128){
        float decay=w32((r*32+head)*2),beta=w32((r*32+head)*2+1);
        precise float memory=0;
        for(uint j=0;j<128;++j){state[j]*=decay;memory+=state[j]*dk[j];}
        float delta=(xf(r*8192+4096+head*128+t)-memory)*beta;
        precise float outv=0;
        for(uint j=0;j<128;++j){state[j]+=dk[j]*delta;outv+=state[j]*dq[j];}
        put(r*4096+head*128+t,outv);
      }barrier();
    }return;
  }
  if(op==30) {
    // FP32 spatial group normalization; weights and biases share one buffer.
    uint width=cols/32,count=n*width;
    precise float sum=0,sq=0;
    for(uint j=t;j<count;j+=256){float a=x32((j/width)*cols+g*width+j%width);sum+=a;sq+=a*a;}
    s[t]=sum;squares[t]=sq;barrier();
    for(uint d=128;d>0;d/=2){if(t<d){s[t]+=s[t+d];squares[t]+=squares[t+d];}barrier();}
    float mean=s[0]/float(count),inv=inversesqrt(max(squares[0]/float(count)-mean*mean,0)+1e-6);
    for(uint j=t;j<count;j+=256){uint c=g*width+j%width,at=(j/width)*cols+c;
      precise float a=(x32(at)-mean)*inv*w32(c)+b32(c);put32(at,p[3]!=0?a/(1+exp(-a)):a);
    }return;
  }
  if(i>=n)return;
  if(op==17){uint c=i%cols;put(i,bf(bf(xf(i)*bf(1+wf((p[3]+1)*cols+c)))+wf(p[3]*cols+c)));}
  if(op==18){float a=xf(i);
    if(p[2]!=0){float gate=wf(i);
      if(p[3]!=0){float gg=bf(4*bf(tanh(bf(gate/4))));gg=bf(gg*bf(1/(1+exp(-gate))));a=bf(25*bf(tanh(bf(a/25))))*gg;}
      else if(p[4]==2)a*=gate/(1+exp(-gate));
      else a*=bf(p[4]!=0?1/(1+exp(-gate)):gate/(1+exp(-gate)));
    }else a=a/(1+exp(-a));put(i,a);
  }
  if(op==19){uint row=i/cols,c=i%cols;precise float a=0;
    for(uint j=0;j<4;++j)if(row+j>=3)a+=xf((row+j-3)*cols+c)*wf(c*4+j);
    put(i,a/(1+exp(-a)));
  }
  if(op==20){uint c=i%32;float a=xf(i)+b32(32+c),softplus=a>20?a:log(1+exp(a));
    put32(i*2,exp(-exp(b32(c))*softplus));put32(i*2+1,bf(1/(1+exp(-wf(i)))));
  }
  if(op==23){float a=xf(i);put(i,.5*a*(1+(p[2]!=0?tanh(.7978845608*(a+.044715*a*a*a)):erf_approx(a*.7071067812))));}
  if(op==24)y[(i/cols)*p[3]+p[4]+i%cols]=x[i];
  if(op==25){uint at=uint(w32(i/cols))*cols+i%cols;float old=uintBitsToFloat(uint(y[at])<<16);put(at,p[3]!=0?old+xf(i):xf(i));}
  if(op==26){uint row=i/cols,c=i%cols;float a=wf(((row>=p[3]&&row<p[4])?4:0)*cols+p[5]*cols+c);put(i,xf(i)*bf(p[6]!=0?tanh(a):1+a));}
  if(op==27)put(i,xf(i)*bf(1+wf(i%cols)));
  if(op==28)put(i,fma(wf(i),uintBitsToFloat(p[3]),xf(i)));
  if(op==29){uint row=p[3]+i/cols,c=i%cols,k=p[6],ci=p[7],stride=p[8],ow=p[9];
    int pad=stride==1?int(k/2):0,yy=int(row/ow*stride+c/k%k)-pad,xx=int(row%ow*stride+c%k)-pad;
    put32(i,yy>=0&&yy<int(p[4])&&xx>=0&&xx<int(p[5])?x32((uint(yy)*p[5]+uint(xx))*ci+c/(k*k)):0);
  }
}
void main() {
  uint t=gl_LocalInvocationID.x,g=gl_WorkGroupID.x+gl_WorkGroupID.y*p[15];
  uint i=g*256+t,op=p[0],n=p[1],cols=p[2];
  if(op>=16){image_operation(op,g,t);return;}
  if(op==0 || op==10) {
    if(g>=n)return;
    precise float sum=0;
    for(uint c=t;c<cols;c+=256){float a=op==0?xf(g*cols+c):x32(g*cols+c);sum+=a*a;}
    s[t]=sum;barrier();
    for(uint d=128;d>0;d/=2){if(t<d)s[t]+=s[t+d];barrier();}
    float inv=op==0?inversesqrt(s[0]/float(cols)+1e-5):sqrt(float(cols))/max(sqrt(s[0]),1e-12);
    for(uint c=t;c<cols;c+=256){
      if(op==0)put(g*cols+c,xf(g*cols+c)*inv*(1+w32(c)));
      else {precise float a=x32(g*cols+c)*inv*w32(c);put32(g*cols+c,p[3]!=0?a/(1+exp(-a)):a);}
    }
    return;
  }
  if(op==6) {
    if(g>=n)return;
    uint head=g%20,row=g/20,batch=row/12;
    for(uint j=0;j<12;++j){
      s[t]=t<128?xf(row*2560+head*128+t)*wf((batch*12+j)*2560+head*128+t):0;
      barrier();
      for(uint d=64;d>0;d/=2){if(t<d)s[t]+=s[t+d];barrier();}
      if(t==0)scores[j]=s[0]*.08838834764831845;barrier();
    }
    if(t==0){float mx=scores[0],sum=0;
      for(uint j=1;j<12;++j)mx=max(mx,scores[j]);
      for(uint j=0;j<12;++j){scores[j]=exp(scores[j]-mx);sum+=scores[j];}
      for(uint j=0;j<12;++j)scores[j]/=sum;
    }barrier();
    if(t<128){precise float value=0;for(uint j=0;j<12;++j)value+=scores[j]*bf_((batch*12+j)*2560+head*128+t);put(row*2560+head*128+t,value);}
    return;
  }
  if(op==14) {
    if(g>=n)return;
    float mx=-uintBitsToFloat(0x7f800000);
    for(uint c=t;c<cols;c+=256)mx=max(mx,x32(g*cols+c)*uintBitsToFloat(p[3]));
    s[t]=mx;barrier();for(uint d=128;d>0;d/=2){if(t<d)s[t]=max(s[t],s[t+d]);barrier();}
    mx=s[0];barrier();float sum=0;
    for(uint c=t;c<cols;c+=256)sum+=exp(x32(g*cols+c)*uintBitsToFloat(p[3])-mx);
    s[t]=sum;barrier();for(uint d=128;d>0;d/=2){if(t<d)s[t]+=s[t+d];barrier();}
    for(uint c=t;c<cols;c+=256)put32(g*cols+c,exp(x32(g*cols+c)*uintBitsToFloat(p[3])-mx)/s[0]);
    return;
  }
  if(i>=n)return;
  if(op==1)put(i,bf(xf(i)*bf(1+wf(p[3]*cols+i%cols)))+wf((p[3]+1)*cols+i%cols));
  if(op==2)put(i,xf(i)+(p[3]!=0?bf(wf(i)*bf_(p[4]*cols+i%cols)):wf(i)));
  if(op==3){float a=xf(i);
    if(p[3]==0)put(i,.5*a*(1+tanh(.7978845608*(a+.044715*a*a*a))));
    else put(i,a*bf(1/(1+exp(-wf(i)))));
  }
  if(op==4){uint halfdim=cols/2,j=i%halfdim,row=i/(halfdim*p[3]),base=(i/halfdim)*cols;
    uint a=p[4]!=0?2*j:j,bb=p[4]!=0?2*j+1:j+halfdim;
    precise float va=xf(base+a),vb=xf(base+bb),cs=w32(row*halfdim+j),sn=b32(row*halfdim+j);
    put(base+a,va*cs-vb*sn);put(base+bb,vb*cs+va*sn);
  }
  if(op==5){precise float value=0;for(uint j=0;j<12;++j)value+=xf(((i/2560)*12+j)*2560+i%2560)*wf(j);put(i,value);}
  if(op==7){uint c=i%cols,row=i/cols,head=c/128; y[i]=x[row*p[3]*128+(head/(p[4]/p[3]))*128+c%128];}
  if(op==8){uint row=i/cols,c=i%cols;y[(row*12+p[3])*cols+c]=x[(row+34)*cols+c];}
  if(op==9){
    uint col=i%cols,r=p[3]+i/cols,kernel=p[6],ci=p[7];
    int yy=int(r/p[5])+int((col/kernel)%kernel)-int(kernel/2);
    int xx=int(r%p[5])+int(col%kernel)-int(kernel/2);
    put32(i,yy>=0&&yy<int(p[4])&&xx>=0&&xx<int(p[5])?x32((uint(yy)*p[5]+uint(xx))*ci+col/(kernel*kernel)):0);
  }
  if(op==11){uint r=i/cols,c=i%cols;put32(i,x32(((r/(2*p[3])/2)*p[3]+(r%(2*p[3]))/2)*cols+c));}
  if(op==12)put32(i,x32(i)+w32(i));
  if(op==13)put32(i,x32((i/cols)*p[3]+p[4]+i%cols));
}
