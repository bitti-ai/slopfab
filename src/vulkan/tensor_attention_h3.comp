#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_bfloat16 : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_scalar_block_layout : require

// Shared exact-mode H3 attention. One four-subgroup workgroup owns sixteen
// globally aligned query rows and one head. Ragged BF16 Q/K and FP16 V tiles
// are staged and zero padded before fixed 16x16x16 cooperative operations.
// Selected keys remain ordered 64-row blocks with one continuous recurrence.
layout(local_size_x = 1024) in;
layout(set = 0, binding = 0, std430) readonly buffer QueryData { uint words[]; } query_data;
layout(set = 0, binding = 1, std430) readonly buffer KeyData { uint words[]; } key_data;
layout(set = 0, binding = 2, std430) readonly buffer ValueData { uint words[]; } value_data;
layout(set = 0, binding = 3, std430) buffer OutputData { uint words[]; } output_data;
#ifdef H3_BANDED
layout(set = 0, binding = 4, std430) readonly buffer RangeData { int bounds[]; } range_data;
#endif

layout(push_constant) uniform Parameters {
  uint sequence;
  uint heads;
  uint head_dim;
  uint scale_bits;
  uint query_row_offset;
  uint output_row_offset;
  uint rows;
  uint reserved;
} p;

shared bfloat16_t query_stage[8192];
shared bfloat16_t key_stage[8192];
shared float16_t value_stage[2048];
shared float scores[4096];
shared float16_t probabilities[4096];
shared float output_accumulators[8192];
shared float soft_partial[1024];
shared float next_maximum[64];
shared float running_max[64];
shared float running_sum[64];
shared float correction[64];

uint load_u16(uint source, uint index) {
  uint packed = source == 0u ? query_data.words[index >> 1u]
      : source == 1u ? key_data.words[index >> 1u]
                     : value_data.words[index >> 1u];
  return (packed >> (16u * (index & 1u))) & 0xffffu;
}

float load_bf16(uint source, uint index) {
  uint bits = load_u16(source, index);
  if ((bits & 0x7f80u) == 0u)
    return uintBitsToFloat((bits & 0x8000u) << 16u);
  return uintBitsToFloat(bits << 16u);
}

uint fp16_rte(float value) {
  uint bits = floatBitsToUint(value);
  uint sign = (bits >> 16u) & 0x8000u;
  uint exponent_bits = (bits >> 23u) & 0xffu;
  uint mantissa = bits & 0x007fffffu;
  if (exponent_bits == 0xffu) return mantissa == 0u ? sign | 0x7c00u : 0x7fffu;
  if (exponent_bits == 0u) return sign;
  int exponent = int(exponent_bits) - 127;
  if (exponent > 15) return sign | 0x7c00u;
  if (exponent >= -14) {
    uint rounded = mantissa + 0x00000fffu + ((mantissa >> 13u) & 1u);
    uint half_exponent = uint(exponent + 15);
    if ((rounded & 0x00800000u) != 0u) { rounded = 0u; ++half_exponent; }
    if (half_exponent >= 31u) return sign | 0x7c00u;
    return sign | (half_exponent << 10u) | ((rounded >> 13u) & 0x03ffu);
  }
  if (exponent < -25) return sign;
  uint significand = 0x00800000u | mantissa;
  uint shift = uint(-exponent - 1);
  uint base = significand >> shift;
  uint remainder = significand & ((1u << shift) - 1u);
  uint halfway = 1u << (shift - 1u);
  if (remainder > halfway || (remainder == halfway && (base & 1u) != 0u)) ++base;
  return sign | base;
}

uint fp16_to_fp32_bits(uint bits) {
  uint sign = (bits & 0x8000u) << 16u;
  uint exponent = (bits >> 10u) & 0x1fu;
  uint mantissa = bits & 0x03ffu;
  if (exponent == 0x1fu) return mantissa == 0u ? sign | 0x7f800000u : 0x7fffffffu;
  if (exponent != 0u) return sign | ((exponent + 112u) << 23u) | (mantissa << 13u);
  if (mantissa == 0u) return sign;
  uint leading = uint(findMSB(mantissa));
  return sign | ((103u + leading) << 23u) |
         ((mantissa << (23u - leading)) & 0x007fffffu);
}

float f16_round(float value) {
  return uintBitsToFloat(fp16_to_fp32_bits(fp16_rte(value)));
}

uint bf16_rte(float value) {
  uint bits = floatBitsToUint(value);
  if ((bits & 0x7fffffffu) > 0x7f800000u) return 0x7fffu;
  return (bits + 0x7fffu + ((bits >> 16u) & 1u)) >> 16u;
}

float canonicalize_subnormal(float value) {
  uint bits = floatBitsToUint(value);
  return (bits & 0x7fffffffu) < 0x00800000u
      ? uintBitsToFloat(bits & 0x80000000u) : value;
}

float deterministic_exp_nonpositive(float value) {
  if (value <= -87.0f) return 0.0f;
  precise float scaled = value * 1.4426950408889634f;
  int exponent = int(scaled);
  if (float(exponent) > scaled) --exponent;
  precise float remainder = fma(-float(exponent), 0.693145751953125f, value);
  remainder = fma(-float(exponent), 1.428606765330187e-6f, remainder);
  precise float polynomial = 2.7557319223985893e-7f;
  polynomial = fma(polynomial, remainder, 2.755731922398589e-6f);
  polynomial = fma(polynomial, remainder, 2.48015873015873e-5f);
  polynomial = fma(polynomial, remainder, 1.984126984126984e-4f);
  polynomial = fma(polynomial, remainder, 1.388888888888889e-3f);
  polynomial = fma(polynomial, remainder, 8.333333333333333e-3f);
  polynomial = fma(polynomial, remainder, 4.166666666666667e-2f);
  polynomial = fma(polynomial, remainder, 1.666666666666667e-1f);
  polynomial = fma(polynomial, remainder, 0.5f);
  polynomial = fma(polynomial, remainder, 1.0f);
  polynomial = fma(polynomial, remainder, 1.0f);
  return polynomial * uintBitsToFloat(uint(exponent + 127) << 23u);
}

uint64_t round_quotient_even(uint64_t numerator, uint64_t denominator) {
  uint64_t quotient = numerator / denominator;
  uint64_t remainder = numerator - quotient * denominator;
  uint64_t complement = denominator - remainder;
  if (remainder > complement ||
      (remainder == complement && (quotient & 1ul) != 0ul)) ++quotient;
  return quotient;
}

float deterministic_divide(float numerator_value, float denominator_value) {
  uint numerator_bits = floatBitsToUint(numerator_value);
  uint denominator_bits = floatBitsToUint(denominator_value);
  uint sign = (numerator_bits ^ denominator_bits) & 0x80000000u;
  uint numerator_magnitude = numerator_bits & 0x7fffffffu;
  uint denominator_magnitude = denominator_bits & 0x7fffffffu;
  if (numerator_magnitude < 0x00800000u) return uintBitsToFloat(sign);
  uint a = (numerator_magnitude & 0x007fffffu) | 0x00800000u;
  uint b = (denominator_magnitude & 0x007fffffu) | 0x00800000u;
  int exponent = int(numerator_magnitude >> 23u) -
                 int(denominator_magnitude >> 23u) + 127;
  uint shift = 23u;
  if (a < b) { --exponent; shift = 24u; }
  uint64_t significand = round_quotient_even(uint64_t(a) << shift, uint64_t(b));
  if (significand == (1ul << 24u)) { significand >>= 1u; ++exponent; }
  if (exponent >= 255) return uintBitsToFloat(sign | 0x7f800000u);
  if (exponent <= 0) {
    uint sub_shift = uint(1 - exponent);
    if (sub_shift >= 64u) return uintBitsToFloat(sign);
    uint64_t base = significand >> sub_shift;
    uint64_t lost = significand & ((1ul << sub_shift) - 1ul);
    uint64_t halfway = 1ul << (sub_shift - 1u);
    if (lost > halfway || (lost == halfway && (base & 1ul) != 0ul)) ++base;
    return uintBitsToFloat(sign | uint(base));
  }
  return uintBitsToFloat(sign | (uint(exponent) << 23u) |
                         (uint(significand) & 0x007fffffu));
}



void main() {
  uint tid = gl_LocalInvocationID.x;
  uint subgroup = gl_SubgroupID;
  uint aligned_first = p.query_row_offset & ~63u;
  uint query_base = aligned_first + gl_WorkGroupID.x * 64u;
  uint request_end = p.query_row_offset + p.rows;
  uint head = gl_WorkGroupID.y;
  float scale = uintBitsToFloat(p.scale_bits);
  for (uint i = tid; i < 64u * p.head_dim; i += gl_WorkGroupSize.x) {
    uint row = i / p.head_dim;
    uint d = i - row * p.head_dim;
    uint query_row = query_base + row;
    query_stage[i] = bfloat16_t(query_row < p.sequence
        ? load_bf16(0u, (query_row * p.heads + head) * p.head_dim + d)
        : 0.0f);
    output_accumulators[i] = 0.0f;
  }
  if (tid < 64u) {
    running_max[tid] = uintBitsToFloat(0xff800000u);
    running_sum[tid] = 0.0f;
  }
  barrier();

#ifdef H3_BANDED
  uint range_base = (query_base / 128u) * 4u;
  int range_values[4] = int[4](range_data.bounds[range_base],
      range_data.bounds[range_base + 1u], range_data.bounds[range_base + 2u],
      range_data.bounds[range_base + 3u]);
  const uint range_count = 2u;
#else
  int range_values[4] = int[4](0, int(p.sequence), 0, 0);
  const uint range_count = 1u;
#endif
  for (uint range_index = 0u; range_index < range_count; ++range_index) {
    uint range_start = uint(max(range_values[range_index * 2u], 0));
    uint range_stop = uint(max(range_values[range_index * 2u + 1u], 0));
    for (uint key_base = range_start; key_base < range_stop; key_base += 64u) {
      for (uint i = tid; i < 64u * p.head_dim; i += gl_WorkGroupSize.x) {
        uint key_in_block = i / p.head_dim;
        uint d = i - key_in_block * p.head_dim;
        uint key_row = key_base + key_in_block;
        key_stage[i] = bfloat16_t(
            key_row < range_stop && key_row < p.sequence
                ? load_bf16(1u, (key_row * p.heads + head) * p.head_dim + d)
                : 0.0f);
      }
      barrier();
      if (subgroup < 16u) {
        uint query_tile = subgroup >> 2u;
        uint key_tile = subgroup & 3u;
        coopmat<float, gl_ScopeSubgroup, 16, 16,
                gl_MatrixUseAccumulator> score_fragment =
            coopmat<float, gl_ScopeSubgroup, 16, 16,
                    gl_MatrixUseAccumulator>(0.0f);
        for (uint d_base = 0u; d_base < p.head_dim; d_base += 16u) {
          coopmat<bfloat16_t, gl_ScopeSubgroup, 16, 16,
                  gl_MatrixUseA> a;
          coopMatLoad(a, query_stage,
                      query_tile * 16u * p.head_dim + d_base, p.head_dim,
                      gl_CooperativeMatrixLayoutRowMajor);
          coopmat<bfloat16_t, gl_ScopeSubgroup, 16, 16,
                  gl_MatrixUseB> b;
          coopMatLoad(b, key_stage, key_tile * 16u * p.head_dim + d_base,
                      p.head_dim, gl_CooperativeMatrixLayoutColumnMajor);
          score_fragment = coopMatMulAdd(a, b, score_fragment);
        }
        coopMatStore(score_fragment, scores,
                     query_tile * 16u * 64u + key_tile * 16u, 64u,
                     gl_CooperativeMatrixLayoutRowMajor);
      }
      barrier();
      for (uint i = tid; i < 4096u; i += gl_WorkGroupSize.x) {
        uint key_row = key_base + (i & 63u);
        scores[i] = key_row < range_stop && key_row < p.sequence
            ? canonicalize_subnormal(scores[i] * scale)
            : uintBitsToFloat(0xff800000u);
      }
      barrier();

      uint row = tid >> 4u;
      uint part = tid & 15u;
      precise float part_max = uintBitsToFloat(0xff800000u);
      for (uint j = part * 4u; j < part * 4u + 4u; ++j)
        part_max = max(part_max, scores[row * 64u + j]);
      soft_partial[tid] = part_max;
      barrier();
      if (part == 0u) {
        float tile_max = soft_partial[tid];
        for (uint i = 1u; i < 16u; ++i)
          tile_max = max(tile_max, soft_partial[tid + i]);
        float next = max(running_max[row], tile_max);
        correction[row] = running_max[row] == uintBitsToFloat(0xff800000u)
            ? 0.0f
            : deterministic_exp_nonpositive(running_max[row] - next);
        next_maximum[row] = next;
      }
      barrier();
      for (uint j = part * 4u; j < part * 4u + 4u; ++j) {
        float score = scores[row * 64u + j];
        float exponential = score == uintBitsToFloat(0xff800000u)
            ? 0.0f : deterministic_exp_nonpositive(score - next_maximum[row]);
        probabilities[row * 64u + j] = float16_t(f16_round(exponential));
        scores[row * 64u + j] = exponential;
      }
      barrier();
      if (part < 8u) {
        precise float chunk_sum = 0.0f;
        for (uint j = part * 8u; j < part * 8u + 8u; ++j)
          chunk_sum = chunk_sum + scores[row * 64u + j];
        soft_partial[row * 8u + part] = chunk_sum;
      }
      barrier();
      if (part == 0u) {
        float tile_sum = soft_partial[row * 8u];
        for (uint i = 1u; i < 8u; ++i)
          tile_sum = tile_sum + soft_partial[row * 8u + i];
        running_sum[row] = fma(running_sum[row], correction[row], tile_sum);
        running_max[row] = next_maximum[row];
      }
      barrier();

      for (uint i = tid; i < 64u * p.head_dim; i += gl_WorkGroupSize.x) {
        uint output_row = i / p.head_dim;
        output_accumulators[i] = canonicalize_subnormal(
            output_accumulators[i] * correction[output_row]);
      }
      barrier();
      coopmat<float, gl_ScopeSubgroup, 16, 16,
              gl_MatrixUseAccumulator> pv_fragment;
      uint d_tiles = p.head_dim / 16u;
      uint total_tiles = 4u * d_tiles;
      if (subgroup < total_tiles) {
        uint tile_query = subgroup / d_tiles;
        uint d_tile = subgroup - tile_query * d_tiles;
        coopMatLoad(pv_fragment, output_accumulators,
                    tile_query * 16u * p.head_dim + d_tile * 16u,
                    p.head_dim, gl_CooperativeMatrixLayoutRowMajor);
      }
      for (uint key_part = 0u; key_part < 64u; key_part += 16u) {
        for (uint i = tid; i < 16u * p.head_dim; i += gl_WorkGroupSize.x) {
          uint key_in_part = i / p.head_dim;
          uint d = i - key_in_part * p.head_dim;
          uint key_row = key_base + key_part + key_in_part;
          value_stage[i] = float16_t(
              key_row < range_stop && key_row < p.sequence
                  ? f16_round(load_bf16(
                        2u, (key_row * p.heads + head) * p.head_dim + d))
                  : 0.0f);
        }
        barrier();
        if (subgroup < total_tiles) {
            uint tile_query = subgroup / d_tiles;
            uint d_tile = subgroup - tile_query * d_tiles;
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16,
                    gl_MatrixUseA> a;
            coopMatLoad(a, probabilities,
                        tile_query * 16u * 64u + key_part, 64u,
                        gl_CooperativeMatrixLayoutRowMajor);
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16,
                    gl_MatrixUseB> b;
            coopMatLoad(b, value_stage, d_tile * 16u, p.head_dim,
                        gl_CooperativeMatrixLayoutRowMajor);
            pv_fragment = coopMatMulAdd(a, b, pv_fragment);
        }
        barrier();
      }
      if (subgroup < total_tiles) {
          uint tile_query = subgroup / d_tiles;
          uint d_tile = subgroup - tile_query * d_tiles;
          coopMatStore(pv_fragment, output_accumulators,
                       tile_query * 16u * p.head_dim + d_tile * 16u,
                       p.head_dim, gl_CooperativeMatrixLayoutRowMajor);
      }
      barrier();
    }
  }
  uint pairs_per_row = p.head_dim >> 1u;
  for (uint pair = tid; pair < 64u * pairs_per_row; pair += gl_WorkGroupSize.x) {
    uint row = pair / pairs_per_row;
    uint d = (pair - row * pairs_per_row) * 2u;
    uint query_row = query_base + row;
    if (query_row >= p.query_row_offset && query_row < request_end &&
        query_row < p.sequence) {
      uint item = row * p.head_dim + d;
      uint lo = bf16_rte(deterministic_divide(
          output_accumulators[item], running_sum[row]));
      uint hi = bf16_rte(deterministic_divide(
          output_accumulators[item + 1u], running_sum[row]));
      uint output_row = p.output_row_offset + query_row - p.query_row_offset;
      uint output_index = (output_row * p.heads + head) * p.head_dim + d;
      output_data.words[output_index >> 1u] = lo | (hi << 16u);
    }
  }
}
