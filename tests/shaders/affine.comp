#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputValues {
  float values[];
} input_values;

layout(set = 0, binding = 1, std430) writeonly buffer OutputValues {
  float values[];
} output_values;

layout(push_constant) uniform Parameters {
  float scale;
  float bias;
  uint count;
} parameters;

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index < parameters.count) {
    output_values.values[index] =
        input_values.values[index] * parameters.scale + parameters.bias;
  }
}
